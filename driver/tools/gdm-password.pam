#%PAM-1.0
#
# Copyright (C) 2026 The OMS Linux driver contributors
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Managed by the OMS fingerprint setup (marker: OMS fingerprint).
# This file overrides the GDM default in /usr/lib/pam.d/gdm-password so that a
# fingerprint can be used to log in at the GDM greeter, with the normal
# password stack kept as a fallback.
#
# To revert: run  sudo oms-pam-restore   (or just delete this file).

auth       sufficient                  pam_fprintd.so  max-tries=1  timeout=15
auth       include                     system-local-login
auth       optional                    pam_gnome_keyring.so

account    include                     system-local-login

password   include                     system-local-login
password   optional                    pam_gnome_keyring.so use_authtok

session    include                     system-local-login
session    optional                    pam_gnome_keyring.so auto_start
